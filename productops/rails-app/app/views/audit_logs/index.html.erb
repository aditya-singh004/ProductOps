<header class="page-header"><h1>Audit Logs</h1></header>
<table>
  <thead><tr><th>Time</th><th>Actor</th><th>Project</th><th>Entity</th><th>Action</th><th>Metadata</th></tr></thead>
  <tbody>
    <% @activity_logs.each do |log| %>
      <tr>
        <td><%= log.created_at.to_fs(:short) %></td>
        <td><%= log.user&.name || "System" %></td>
        <td><%= log.project&.name %></td>
        <td><%= log.entity_type %>#<%= log.entity_id %></td>
        <td><%= log.action %></td>
        <td><code><%= log.metadata.to_json %></code></td>
      </tr>
    <% end %>
  </tbody>
</table>
