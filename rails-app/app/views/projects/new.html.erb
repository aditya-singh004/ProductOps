<h1>New Project</h1>
<%= form_with model: @project, local: true, class: "stacked-form" do |form| %>
  <%= form.collection_select :organization_id, Organization.order(:name), :id, :name %>
  <%= form.text_field :name, placeholder: "Project name", required: true %>
  <%= form.text_field :key, placeholder: "Project key", required: true %>
  <%= form.text_area :description, placeholder: "Description" %>
  <%= form.submit "Create Project" %>
<% end %>
